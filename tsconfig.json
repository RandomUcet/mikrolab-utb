{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist/js", "lib": ["ES2022", "DOM"],
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }, "include": ["src/**/*.ts"]
}
